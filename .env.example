# Never paste credentials into chat or git.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
ADMIN_DISCORD_USER_ID=

# Confirm all voice participants have consented BEFORE setting true and /start.
VOICE_CAPTURE_CONSENT_CONFIRMED=false

# Optional: silence interval before closing one speaker's receive stream.
AUDIO_SILENCE_MS=850

# Phase 2: explicitly enable after setting an OpenAI API key.
TRANSLATION_ENABLED=false
OPENAI_API_KEY=
# Obtain participant consent specifically for sending audio to OpenAI.
OPENAI_AUDIO_CONSENT_CONFIRMED=false
# Local tests only: prints transcript/translations. Forbidden with NODE_ENV=production.
# true: full captions/translations in per-run logs/*.log; no terminal caption output.
LOCAL_CAPTION_PREVIEW=false
STT_MODEL=gpt-live-transcribe
STT_DELAY=low
ACCURACY_REVIEW_ENABLED=true
CONTEXT_MEMORY_ENABLED=true
STT_LANGUAGES=ko,ru,kk,en
# Context and expected vocabulary are hints; they do not rewrite final transcripts.
# STT_PROMPT=Custom context for your meeting (1000 characters maximum)
# Optional local-test vocabulary. Leave empty to omit; host registration is a future feature.
STT_KEYWORDS=
# Persistent name spellings: edit config/participants.json, then restart the bot.
# Output languages only. English can still be spoken; add ,en to enable its captions.
TRANSLATION_LANGUAGES=ko,ru,kk
TRANSLATION_MODEL=gpt-6.1-terra
# streaming/separate translation effort. Accuracy review and context summary retain low.
# Supported values: none, low, medium, high (subject to the chosen model's support).
TRANSLATION_REASONING_EFFORT=medium
# streaming: partial drafts, same-ID revisions, independent background semantic commitment.
# separate: legacy semantic boundaries then 4 parallel direct target-language requests.
# combined: previous one-request boundaries+translation; compare: 8 text model variants.
CAPTION_MODE=streaming
DRAFT_INTERVAL_MS=1000
SPEECH_SILENCE_MS=2000
# Use compare for one shared STT stream and the eight Luna/Terra/Sol variants.
# Used for background commitment in streaming and foreground segmentation in separate.
SEGMENTATION_MODEL=gpt-6.1-terra
# STT transport checkpoint; streaming captions stay open across checkpoints.
AUDIO_SEGMENT_MS=5000
# Legacy separate/combined deadlines; streaming uses SPEECH_SILENCE_MS instead.
CAPTION_SILENCE_MS=4000
# Safety bound for a fragment that never becomes complete during continuous speech.
CAPTION_MAX_HOLD_MS=8000
# Preserve previous-turn STT context during normal pauses; still at most 3 sessions.
STT_IDLE_TIMEOUT_MS=60000
# Optional local WAV recording. admin records only ADMIN_DISCORD_USER_ID; all records each participant separately.
# Streaming: continuous source WAV + caption JSON/JSONL; no character-ratio audio cuts.
AUDIO_RECORDING_ENABLED=false
AUDIO_RECORDING_SCOPE=admin
# Monthly API spending limit in USD; hosting is separate.
API_MONTHLY_LIMIT_USD=10
# Update prices when changing models. Standard pricing; estimates, not provider billing.
STT_USD_PER_MINUTE=0.017
TRANSLATION_INPUT_USD_PER_MILLION=1.00
TRANSLATION_OUTPUT_USD_PER_MILLION=5.00
SEGMENTATION_INPUT_USD_PER_MILLION=1.00
SEGMENTATION_OUTPUT_USD_PER_MILLION=5.00

# Optional private web receiver (sibling project ../live_translate_ui).
# Leave both empty to disable. This is independent of LOCAL_CAPTION_PREVIEW.
# Use HTTPS outside localhost; RECEIVER_TOKEN must match receiver INGEST_TOKEN (32+ characters).
# RECEIVER_URL=http://localhost:3000
# RECEIVER_TOKEN=
